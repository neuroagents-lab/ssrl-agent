# Copy to local_data/dmc_blind.env in your checkout. Per-command overrides win.
# Activate your Python environment before launching, or explicitly set CONDA_ENV.
# Authenticate separately using `wandb login`; do not put API keys here.

: "${WANDB_ENTITY:=}"
: "${WANDB_MODE:=offline}"
: "${IDM_CONFIG:=vic}"
: "${SEEDS:=0}"
: "${ENV_CONFIG:=dmc_proprio}"
: "${BACKEND_AGENT:=dreamerv3}"
: "${MODEL_CONFIG:=size12M}"
: "${PARTITION:=}"
: "${QOS:=}"
: "${GRES:=gpu:1}"
: "${JAX_PREALLOCATE:=false}"
: "${MEMORY:=64G}"

# Optional: CONDA_ENV=your-environment CONDA_EXE=/path/to/conda/bin/conda
# Optional: PARTITION=gpu QOS=normal GRES=gpu:A100:1 EXCLUDE_NODES=node01
# Optional: WANDB_MODE=online WANDB_ENTITY=your-team
# WORK_LOG_ROOT defaults to runs/ in the checkout.
# SSRL_SOURCE_BUNDLE_ROOT defaults to .runtime/source_bundles/ in the checkout.
# Both locations must be visible on the login node and compute nodes.
# SCRATCH_LOG_ROOT defaults to node-local temporary storage.
